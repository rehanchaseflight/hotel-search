NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace_with_at_least_32_random_characters
CRED_ENCRYPTION_KEY=replace_with_64_hex_characters

# Supplier APIs - real values belong in Render environment variables, never GitHub.
