{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hotel-search",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-04",
  "vars": {
    "BACKEND_URL": "https://YOUR-RENDER-SERVICE.onrender.com"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  }
}
