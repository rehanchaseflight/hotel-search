{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hotel-search-portal",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  }
}
